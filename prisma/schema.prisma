// Projeto Material Mnemônico de Alta Retenção para Concursos — esquema inicial.
// Identificadores em inglês; rótulos de interface ficam no front-end.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  runtime         = "nodejs"
  // O resto do backend compila para CommonJS; o client precisa acompanhar.
  moduleFormat    = "cjs"
  // Habilita `relationLoadStrategy: 'join'`: uma consulta com relação vira um
  // único LATERAL JOIN em vez de uma ida ao banco por nível. O resolvedor de
  // sessão roda a cada requisição autenticada — o round-trip extra pesa.
  previewFeatures = ["relationJoins"]
}

// A partir do Prisma 7 a URL não vive mais aqui:
//  - runtime  -> driver adapter (@prisma/adapter-pg) em src/lib/prisma.ts
//  - migrate  -> prisma.config.ts
datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  EDITOR
  ADMIN
}

/// Técnica usada para construir o gancho mnemônico.
enum MnemonicTechnique {
  ACRONYM
  ACROSTIC
  STORY
  MEMORY_PALACE
  KEYWORD
  RHYME
  NUMBER_PEG
}

/// Autoavaliação do estudante na revisão (escala SM-2 simplificada).
enum ReviewRating {
  AGAIN
  HARD
  GOOD
  EASY
}

/// Classe do radar de prova: as cinco classes da TAP (§3.2 camada 1), dado
/// persistido no Conteúdo bruto. As três prioridades de apresentação
/// (Alta/Média/Baixa) são derivação de tela, não coluna (DEC-006-009).
enum ProofRadarClass {
  ALTA
  MEDIA
  DETALHE
  EXCECAO
  PEGADINHA
}

/// Gênero da fonte normativa embutida no Conteúdo bruto (DEC-006-002).
enum NormativeSourceType {
  CF
  CTN
  LEI
  LEI_COMPLEMENTAR
  SUMULA
  ATO_NORMATIVO
}

model User {
  id String @id @default(uuid(7))

  email String @unique
  name  String

  /// Hash Argon2id. A senha em claro nunca é persistida nem registrada em log.
  passwordHash String
  role         UserRole @default(STUDENT)

  /// Conta desativada de forma reversível (FR-002-018). null = conta ativa.
  disabledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cardStates CardState[]
  reviews    Review[]
  sessions   Session[]

  rawContents       RawContent[] @relation("RawContentAuthor")
  editedRawContents RawContent[] @relation("RawContentLastEditor")

  @@map("users")
}

/// Repositório de sessão: credencial de acesso + token de renovação guardados só como
/// hash, com rotação por família (DEC-003-003). Apenas a equipe interna autentica.
model Session {
  id String @id @default(uuid(7))

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Agrupa a cadeia de rotação derivada de um mesmo login (Família de sessão).
  familyId String

  /// HMAC-SHA256(token, pepper) via `crypto.createHmac('sha256', env.JWT_SECRET)` — o
  /// valor em claro do token nunca é persistido. Token gerado com `crypto.randomBytes`;
  /// verificação por `crypto.timingSafeEqual`.
  accessTokenHash  String @unique
  refreshTokenHash String @unique

  accessExpiresAt  DateTime
  /// Expiração absoluta de 7 dias (FR-002-005).
  refreshExpiresAt DateTime
  /// Setado quando este refresh foi trocado por um sucessor.
  rotatedAt        DateTime?
  /// Setado por logout, reuso, troca de senha ou desativação.
  revokedAt        DateTime?

  createdIp String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

model Discipline {
  id String @id @default(uuid(7))

  name String
  slug String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topics Topic[]

  @@map("disciplines")
}

model Topic {
  id String @id @default(uuid(7))

  disciplineId String
  discipline   Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)

  name String
  slug String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mnemonics   Mnemonic[]
  flashcards  Flashcard[]
  rawContents RawContent[]

  @@unique([disciplineId, slug])
  @@map("topics")
}

model Mnemonic {
  id String @id @default(uuid(7))

  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  technique MnemonicTechnique

  /// O gancho em si — a sigla, o acróstico, a rima.
  hook String

  /// O que cada parte do gancho decodifica.
  decoding String

  /// Base legal ou fonte, quando houver.
  source String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  flashcards Flashcard[]

  @@index([topicId, technique])
  @@map("mnemonics")
}

model Flashcard {
  id String @id @default(uuid(7))

  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  /// Cartão pode nascer de um mnemônico ou ser solto.
  mnemonicId String?
  mnemonic   Mnemonic? @relation(fields: [mnemonicId], references: [id], onDelete: SetNull)

  front String
  back  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cardStates CardState[]
  reviews    Review[]

  @@index([topicId])
  @@map("flashcards")
}

/// Estado da repetição espaçada de um cartão para um estudante.
model CardState {
  id String @id @default(uuid(7))

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  flashcardId String
  flashcard   Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  /// Quando o cartão volta à fila.
  dueAt        DateTime @default(now())
  intervalDays Int      @default(0)
  easeFactor   Float    @default(2.5)
  repetitions  Int      @default(0)
  lapses       Int      @default(0)

  updatedAt DateTime @updatedAt

  @@unique([userId, flashcardId])
  @@index([userId, dueAt])
  @@map("card_states")
}

/// Registro imutável de cada revisão — a série histórica que alimenta o algoritmo.
model Review {
  id String @id @default(uuid(7))

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  flashcardId String
  flashcard   Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  rating ReviewRating

  /// Tempo até responder, em milissegundos — hesitação é sinal de retenção fraca.
  elapsedMs Int?

  reviewedAt DateTime @default(now())

  @@index([userId, reviewedAt])
  @@index([flashcardId])
  @@map("reviews")
}

/// Texto normativo colado + disciplina/tema + classe do radar de prova — a
/// primeira estação da linha de produção. A fonte normativa fica embutida em
/// colunas opcionais (DEC-006-002); `deletedAt` marca remoção reversível, dados
/// preservados para expurgo futuro (DEC-006-001).
model RawContent {
  id String @id @default(uuid(7))

  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Restrict)

  /// Autoria original, imutável na edição (FR-005-013). Restrict: apagar um autor
  /// com conteúdo produzido fica bloqueado até F8 definir expurgo (DEC-006-008).
  authorId String
  author   User   @relation("RawContentAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  rawText    String
  radarClass ProofRadarClass

  sourceType     NormativeSourceType?
  sourceCitation String?
  sourceUrl      String?

  /// Carimbo de última alteração (quem/quando), sem trilha histórica. SetNull:
  /// é referência fraca, não vínculo forte (DEC-006-008).
  lastEditedById String?
  lastEditedBy   User?     @relation("RawContentLastEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)
  lastEditedAt   DateTime?

  /// null = ativo. Todo caminho de leitura do service filtra `deletedAt: null`.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  breakdown RuleBreakdown?

  @@index([authorId])
  @@index([topicId])
  /// Cobre `listRawContents` (TASK-006-008) no ramo EDITOR: `where{authorId,
  /// deletedAt} + orderBy createdAt desc` — sem este índice, Seq Scan em
  /// volume de dezenas de milhares de linhas (medido por EXPLAIN).
  @@index([authorId, createdAt(sort: Desc)])
  /// Cobre `listRawContents` no ramo ADMIN (irrestrito): `where{deletedAt} +
  /// orderBy createdAt desc`, sem `authorId` no predicado.
  @@index([createdAt(sort: Desc)])
  /// NÃO redundante com os dois índices acima (confirmado por EXPLAIN): o
  /// `count()` do ramo ADMIN precisa visitar todas as linhas correspondentes
  /// a `deletedAt is null`, sem `LIMIT` — só este índice cobre isso.
  @@index([deletedAt])
  @@map("raw_contents")
}

/// Decomposição do texto normativo nos cinco blocos + síntese; 1:1 com o
/// Conteúdo bruto (FK `@unique`). Não tem `deletedAt` própria — herda a
/// inalcançabilidade do pai (DEC-006-001). Cascade só age sob eventual
/// hard-delete futuro; a remoção de F2 é soft (DEC-006-008).
model RuleBreakdown {
  id String @id @default(uuid(7))

  rawContentId String     @unique
  rawContent   RawContent @relation(fields: [rawContentId], references: [id], onDelete: Cascade)

  concept   String
  action    String
  object    String
  condition String?
  exception String?
  essence   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("rule_breakdowns")
}

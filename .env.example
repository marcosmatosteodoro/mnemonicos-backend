# ─── Aplicação ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3333
LOG_LEVEL=debug

# Origens permitidas no CORS, separadas por vírgula (sem curinga em produção)
CORS_ORIGINS=http://localhost:3000

# ─── Banco de desenvolvimento (docker-compose.yml) ────────────────────────────
# Usadas pelo container do Postgres local e para montar as URLs abaixo.
# Credencial de container descartável — não representa segredo de produção.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mnemonicos
POSTGRES_PORT=5432

# ─── Banco (PostgreSQL) ───────────────────────────────────────────────────────
# Em serverless use SEMPRE a URL com pooler (pgbouncer) em DATABASE_URL.
# DIRECT_URL aponta para a conexão direta e é usada apenas por `prisma migrate`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mnemonicos?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/mnemonicos?schema=public"

# ─── Autenticação ─────────────────────────────────────────────────────────────
# Valor fictício. Gere o seu com: openssl rand -base64 48
# Nunca versione o segredo real — mantenha-o só no .env local e no painel da Vercel.
JWT_SECRET="troque-este-valor-por-um-segredo-gerado-localmente"
JWT_EXPIRES_IN=15m

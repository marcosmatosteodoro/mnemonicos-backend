# ─── Aplicação ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3333
LOG_LEVEL=debug

# Origens permitidas no CORS, separadas por vírgula (sem curinga em produção)
CORS_ORIGINS=http://localhost:3000

# ─── Banco de desenvolvimento (docker-compose.yml) ────────────────────────────
# Usadas pelo container do Postgres local e para montar as URLs abaixo.
# Credencial de container descartável — não representa segredo de produção.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mnemonicos
POSTGRES_PORT=5432

# ─── Banco (PostgreSQL) ───────────────────────────────────────────────────────
# Em serverless use SEMPRE a URL com pooler (pgbouncer) em DATABASE_URL.
# DIRECT_URL aponta para a conexão direta e é usada apenas por `prisma migrate`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mnemonicos?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/mnemonicos?schema=public"

# ─── Autenticação ─────────────────────────────────────────────────────────────
# Valor fictício. Gere o seu com: openssl rand -base64 48
# Nunca versione o segredo real — mantenha-o só no .env local e no painel da Vercel.
# JWT_SECRET segue em uso como pepper do hash de token de sessão (DEC-003-002).
JWT_SECRET="troque-este-valor-por-um-segredo-gerado-localmente"
# JWT_EXPIRES_IN é config morta após a DEC-003-002 (token opaco, não JWT); remoção fora do escopo de F1 (TRISK-003-006).
JWT_EXPIRES_IN=15m

# ─── Sessão: cookies e TTLs ───────────────────────────────────────────────────
# Canal seguro do cookie de sessão. Deixe true em produção (HTTPS); false só em dev/local.
COOKIE_SECURE=false
# Tempo de vida do token de acesso, em minutos (credencial curta).
AUTH_ACCESS_TTL_MINUTES=15
# Expiração absoluta do token de renovação, em dias.
AUTH_REFRESH_TTL_DAYS=7
# Janela de graça (segundos) para renovações concorrentes do SPA sem deslogar.
AUTH_REFRESH_GRACE_SECONDS=10

# ─── Hash de senha (Argon2id — parâmetros de custo, ponto de partida OWASP) ────
# Memória em KiB.
ARGON2_MEMORY_KIB=19456
# Número de iterações.
ARGON2_TIME_COST=2
# Grau de paralelismo.
ARGON2_PARALLELISM=1

# ─── Bootstrap do 1º ADMIN (lido só pelo prisma/seed.ts) ──────────────────────
# Preencha as DUAS para o seed criar o primeiro ADMIN; só uma → tratado como ausente.
# Senha com no mínimo 12 caracteres. Nunca versione a senha real.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD="troque-por-uma-senha-forte-de-bootstrap"
